{
  "name": "sns-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check:i18n": "node scripts/check-translations.js",
    "build": "pnpm check:i18n && vite build",
    "lint": "pnpm --recursive run lint",
    "prepush": "pnpm audit --audit-level=high",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:create": "wrangler d1 create sns-db",
    "kv:create": "wrangler kv namespace create KV"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "svelte-i18n": "^4.0.1"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",

  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "^0.7.0",
      "esbuild@<=0.24.2": "^0.25.0",
      "undici@<7.29.1": "^7.29.1"
    }
  }
}
