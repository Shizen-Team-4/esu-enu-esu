{
	"name": "sns-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"dev": "vite dev",
		"check:i18n": "node scripts/check-translations.js",
		"build": "pnpm check:i18n && vite build",
		"lint": "prettier --check . && pnpm --recursive run lint",
		"format": "prettier --write .",
		"spellcheck": "cspell .",
		"prepush": "pnpm audit --audit-level=high",
		"preview": "wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"types": "wrangler types",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:create": "wrangler d1 create sns-db",
		"kv:create": "wrangler kv namespace create KV",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0",
		"pnpm": ">=10"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.2",
		"cspell": "^10.3.5",
		"dotenv": "^17.0.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.7.6",
		"typescript": "^5.0.0",
		"vite": "^7.0.0",
		"vitest": "^5.0.2",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"svelte-i18n": "^4.0.1"
	}
}
